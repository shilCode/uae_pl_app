# ===========================================
# Polish Consulate Appointment Checker Config
# ===========================================

# Consulate URL (200 = Abu Dhabi)
CONSULATE_URL=https://secure.e-konsulat.gov.pl/placowki/200/wiza-krajowa/wizyty/weryfikacja-obrazkowa

# How often to check for appointments (in milliseconds)
POLL_INTERVAL_MS=30000

# Maximum number of retries before stopping
MAX_RETRIES=500000

# Run browser in headed mode (true = visible browser, false = headless)
HEADED=false

# ── Form selections ──
# Service type: "Wiza krajowa" | "Wiza krajowa - praca" | "Wiza krajowa – studenci"
SERVICE_TYPE=Wiza krajowa

# Location (usually only "Abu Zabi" available)
LOCATION=Abu Zabi

# Number of people: "1 osob" through "8 osob"
NUM_PEOPLE=1 osob

# ── CAPTCHA Settings ──
# Max OCR attempts before falling back to manual (set to 0 to always use manual)
MAX_CAPTCHA_ATTEMPTS=15

# Max time (ms) for CAPTCHA solving before timing out (0 = no timeout)
CAPTCHA_TIMEOUT_MS=120000

# Save debug images of CAPTCHA preprocessing (true/false)
CAPTCHA_DEBUG=false

# ── Email Notifications ──
# Leave SMTP_HOST empty to auto-create a free Ethereal test account (no signup needed).
# Ethereal captures emails and gives you a web link to preview them.
# To use a local server like MailHog/MailPit instead, set SMTP_HOST=localhost and SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_TO=2850542@gmail.com
MAIL_FROM=checker@polish-consulate.local
